# ============================================================
# Unreal Engine 5 (.gitignore)
# Based on the community-standard UE5 gitignore template.
# ============================================================

# --------------------------------------------
# Unreal Engine - generated & cache directories
# --------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Releases/
Collections/
Developers/
Plugins/
__ExternalActors__/
__ExternalObjects__/

# --------------------------------------------
# Unreal Engine - generated project files
# --------------------------------------------
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.tmp
*.vcxproj
*.vcproj
*.user
*.sln.docstates
*.VC.db
*.VC.opendb

# --------------------------------------------
# IDE / Editor
# --------------------------------------------
# Visual Studio
.vs/
.vsconfig

# Visual Studio Code
.vscode/

# JetBrains Rider / CLion
.idea/
.ipch/

# --------------------------------------------
# Crash reports & profiling
# --------------------------------------------
[Cc]rash[Rr]eport[Cc]lient/
MemReport/

# --------------------------------------------
# OS files
# --------------------------------------------
# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# macOS
.DS_Store

# Linux
*.local

# --------------------------------------------
# Misc
# --------------------------------------------
*.bak
*.old
*.orig
*.rej

# --------------------------------------------
# NOTE: Do NOT add *.dll / *.exe / *.lib here.
# Plugins and third-party modules may ship binaries
# that MUST be committed. Ignore only as needed.
# --------------------------------------------